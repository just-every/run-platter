  "agentUpdateInstructions": "Use the pinned rer commands and the committed setup manifest. Review deployment inputs and recovery instructions before installation.",
  "contractChanges": {
    "HTTP-001": {
      "change": "added",
      "summary": "Every proposal, client, import and invoice handler checks a native Base owner or member session, or a revocable owner-bound agent key, before it reads or writes."
    },
    "ACCESS-001": {
      "change": "added",
      "summary": "An owner issues an agent key with a label and a 30-day expiry, stored only as a hash and bound to that owner's current account version."
    },
    "PROP-001": {
      "change": "added",
      "summary": "Every approval names one exact revision."
    },
    "PROP-002": {
      "change": "added",
      "summary": "Sending freezes the approved revision: its scope, options and prices can no longer be edited in place."
    },
    "SIGN-001": {
      "change": "added",
      "summary": "A client invitation grants access only to its own frozen offer."
    },
    "SIGN-002": {
      "change": "added",
      "summary": "Acceptance requires a verified mailbox, a typed full name, one offered option and explicit consent."
    },
    "INV-001": {
      "change": "added",
      "summary": "An owner exports the accepted deposit as an invoice record."
    },
    "IMPORT-001": {
      "change": "added",
      "summary": "The client CSV kit previews the exact source bytes without writing, and applies only the file whose fingerprint was reviewed."
    },
    "ERASE-001": {
      "change": "added",
      "summary": "An owner erases a client by typing the exact client name."
    },
    "PORT-001": {
      "change": "added",
      "summary": "RER archives preserve clients, proposals, revisions, approvals, immutable acceptances and deposit invoices."
    },
    "MAIL-001": {
      "change": "added",
      "summary": "Local proposal and verification mail is captured without a provider."
    },
    "SITE-001": {
      "change": "added",
      "summary": "The public run site is built with `rer build --site`."
    }
  },
  "extensionPointChanges": []
}
