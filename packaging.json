{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/run-platter",
    "name": "Platter",
    "sourceRepository": "https://github.com/just-every/run-platter",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "platter-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile",
      "build": "pnpm run build && pnpm delivery:spec",
      "verify": "pnpm check:deployment-spec && pnpm verify",
      "artifact": "node scripts/delivery/base/cli.mjs artifact --config packaging.json",
      "recovery": "Follow docs/BACKUP-RESTORE.md and OPERATIONS.md. Pause writes and scheduled work, retain exact source and private deployment settings, export the installation, and restore into fresh empty resources. Preserve all applied migration names and bytes. Reconnect providers, reconcile uncertain sends and payments, verify owner access and re-export data before routing traffic."
    },
    "verification": {
      "migrationDirectories": [
        "migrations/core"
      ],
      "guidanceFiles": [
        "AGENTS.md",
        "OPERATIONS.md"
      ],
      "testPatterns": [
        "tests/*.test.mjs"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@ff70d729948753ffdcceeca94aad063af2dcd979",
    "artifactFile": "platter-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ]
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "AUTH_LOCAL",
        "AUTH_ORIGIN",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "MAIL_RELAY_URL",
        "MAIL_ACCOUNT_ID",
        "OWNER_EMAIL",
        "IDENTITY_PROVIDER",
        "GOOGLE_MAIL_CLIENT_ID",
        "MICROSOFT_MAIL_CLIENT_ID",
        "QUESTION_REPLY_DOMAIN",
        "SMS_PROVIDER",
        "TWILIO_FROM"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "SETUP_TOKEN"
      ],
      "optionalSecretNames": [
        "MAIL_API_KEY",
        "MAIL_WEBHOOK_KEY",
        "GOOGLE_MAIL_CLIENT_SECRET",
        "MICROSOFT_MAIL_CLIENT_SECRET",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN"
      ],
      "providerEffects": [
        "outbound-mail",
        "outbound-webhooks"
      ],
      "mail": {
        "providers": [
          "resend",
          "sendgrid",
          "cloudflare",
          "rer"
        ]
      },
      "surfaces": {
        "app": {
          "path": "/app",
          "originVariable": "AUTH_ORIGIN",
          "signIn": {
            "path": "/signin",
            "loginHint": false,
            "ownerSignIn": "/auth/owner-signin"
          }
        }
      },
      "healthPath": "/health",
      "recovery": "Follow docs/BACKUP-RESTORE.md and OPERATIONS.md. Pause writes and scheduled work, retain exact source and private deployment settings, export the installation, and restore into fresh empty resources. Preserve all applied migration names and bytes. Reconnect providers, reconcile uncertain sends and payments, verify owner access and re-export data before routing traffic."
    },
    "mainModule": "index.js"
  }
}
