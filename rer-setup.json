{
  "schema": 1,
  "title": "Platter",
  "groups": [
    {
      "id": "application",
      "label": "Your application"
    },
    {
      "id": "owner",
      "label": "First owner"
    },
    {
      "id": "sms",
      "label": "Optional proposal texts"
    }
  ],
  "fields": [
    {
      "name": "APP_NAME",
      "label": "Application name",
      "help": "The name shown in your new application.",
      "kind": "text",
      "required": true,
      "default": "Platter",
      "group": "application"
    },
    {
      "name": "PRIMARY_COLOR",
      "label": "Brand colour",
      "kind": "colour",
      "required": true,
      "default": "#1F2121",
      "group": "application"
    },
    {
      "name": "OWNER_EMAIL",
      "label": "Owner email",
      "help": "The owner account for this installation. Local development opens signed in; no email is sent.",
      "kind": "email",
      "required": true,
      "prefill": "account-email",
      "group": "owner"
    },
    {
      "name": "SESSION_SECRET",
      "label": "Session secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "SETUP_TOKEN",
      "label": "Setup token",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "IDENTITY_PROVIDER",
      "label": "Identity provider",
      "kind": "url",
      "required": false,
      "help": "Optional Auth install. Leave empty to use email links.",
      "default": ""
    },
    {
      "name": "MAIL_PROVIDER",
      "label": "Mail provider",
      "kind": "select",
      "required": true,
      "default": "resend",
      "options": [
        {
          "value": "resend",
          "label": "Resend"
        },
        {
          "value": "sendgrid",
          "label": "SendGrid"
        },
        {
          "value": "cloudflare",
          "label": "Cloudflare Email Sending"
        },
        {
          "value": "rer",
          "label": "RER managed mail"
        },
        {
          "value": "development",
          "label": "Local development (no mail)"
        }
      ],
      "help": "Local development sends no email. For hosting, choose a configured provider and a verified sender."
    },
    {
      "name": "MAIL_FROM",
      "label": "Sender address",
      "kind": "text",
      "required": false,
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "cloudflare"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        }
      ]
    },
    {
      "name": "MAIL_RELAY_URL",
      "label": "Managed mail relay URL",
      "kind": "url",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      }
    },
    {
      "name": "MAIL_API_KEY",
      "label": "Mail API key",
      "kind": "secret",
      "input": "entered",
      "ownerVisible": true,
      "required": false,
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "cloudflare"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        }
      ]
    },
    {
      "name": "MAIL_ACCOUNT_ID",
      "label": "Cloudflare account ID",
      "kind": "text",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "cloudflare"
      }
    },
    {
      "name": "SMS_PROVIDER",
      "label": "Text message provider",
      "kind": "select",
      "required": true,
      "default": "disabled",
      "group": "sms",
      "options": [
        {
          "value": "disabled",
          "label": "No text messages"
        },
        {
          "value": "twilio",
          "label": "Twilio"
        }
      ],
      "help": "Optional. Enabling transport does not record recipient assent or authorize any proposal text."
    },
    {
      "name": "TWILIO_ACCOUNT_SID",
      "label": "Twilio account SID",
      "kind": "secret",
      "required": true,
      "group": "sms",
      "when": {
        "field": "SMS_PROVIDER",
        "equals": "twilio"
      },
      "help": "The account that owns the qualified sender.",
      "input": "entered",
      "ownerVisible": true
    },
    {
      "name": "TWILIO_AUTH_TOKEN",
      "label": "Twilio auth token",
      "kind": "secret",
      "required": true,
      "group": "sms",
      "when": {
        "field": "SMS_PROVIDER",
        "equals": "twilio"
      },
      "help": "Used privately for sending and checking signed Twilio callbacks.",
      "input": "entered",
      "ownerVisible": true
    },
    {
      "name": "TWILIO_FROM",
      "label": "Qualified US sender number",
      "kind": "text",
      "required": true,
      "group": "sms",
      "when": {
        "field": "SMS_PROVIDER",
        "equals": "twilio"
      },
      "help": "Registered A2P 10DLC or verified toll-free sender in international format. Confirm carrier eligibility in your Twilio account before production use."
    }
  ],
  "steps": [
    {
      "type": "extension",
      "id": "branding"
    },
    {
      "type": "owner-claim",
      "mode": "signed",
      "emailField": "OWNER_EMAIL",
      "tokenField": "SETUP_TOKEN",
      "path": "/auth/owner-claim"
    }
  ],
  "dependencies": [
    {
      "interface": "oidc-provider@1",
      "optional": true,
      "cardinality": 1,
      "address": "IDENTITY_PROVIDER",
      "paths": [
        "/auth/oidc/auth/callback",
        "/auth/oidc/auth/logout"
      ]
    }
  ],
  "business": {
    "settings": 1,
    "values": [
      "display_name"
    ],
    "team": {
      "roles": {
        "admin": "admin",
        "member": "member"
      }
    }
  }
}
