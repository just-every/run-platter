{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proposals-platter",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foundation",
      "database_id": "local-foundation-only",
      "migrations_dir": "migrations/core"
    }
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "vars": {
    "AUTH_LOCAL": "false",
    "AUTH_ORIGIN": "",
    "MAIL_PROVIDER": "resend",
    "MAIL_FROM": "",
    "MAIL_RELAY_URL": "",
    "MAIL_ACCOUNT_ID": "",
    "OWNER_EMAIL": "",
    "IDENTITY_PROVIDER": "",
    "GOOGLE_MAIL_CLIENT_ID": "",
    "MICROSOFT_MAIL_CLIENT_ID": "",
    "QUESTION_REPLY_DOMAIN": ""
  }
}
